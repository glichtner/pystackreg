# Files added to the source distribution in addition to the package itself.
include LICENSE* NOTICE* AUTHORS.rst CHANGELOG.rst CITATION.cff
include inc/*.h
include src/*.cpp
recursive-include tests *.py *.tif *.npz *.json
recursive-include tools *.py *.sh
recursive-include docs *.rst *.md *.py *.png *.txt Makefile make.bat
recursive-include examples *.ijm *.tif *.ipynb
prune docs/_build
global-exclude *.py[cod] __pycache__ *.so *.pyd .DS_Store
